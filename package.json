{
  "name": "react-unit-test-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable React unit testing Agent Skill with optional deterministic local analysis and test helpers",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "bundle:skill": "npm run build && node scripts/package-skill.mjs",
    "test:skill": "node scripts/skill-smoke.mjs",
    "test:demo": "npm run test --prefix examples/demo-react",
    "coverage:demo": "npm run test:coverage --prefix examples/demo-react"
  },
  "dependencies": { "typescript": "^5.9.3" },
  "devDependencies": { "@types/node": "^22.0.0" }
}
